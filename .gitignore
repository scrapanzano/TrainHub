node_modules
dist
dist-ssr
# Covers .env.local, which holds the Supabase URL and publishable key.  Those
# never enter the repository -- copy .env.example on a new machine and refill it
# from the Supabase dashboard.
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tooling caches
.impeccable/
**/.impeccable/

# Subagent scratch.  The progress ledger and the task reports ARE tracked -- they
# are the record of why the code looks the way it does, and the ledger is what
# lets work resume on another machine.  Briefs regenerate from the plans and
# review diffs regenerate from git, so neither is worth carrying.
.superpowers/sdd/*.diff
.superpowers/sdd/task-*-brief.md
.superpowers/sdd/**/task-*-brief.md

# Build artefact of the LaTeX sources
Relazione/main.pdf
